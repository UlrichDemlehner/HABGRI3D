<tr><td style="width: 35%;">von 1611 bis 1619-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0e524b13c9bb4fcd8164b1ffaa871c46" target="_blank">Gimpler, Thomas</a></td></tr>
<tr><td style="width: 35%;">von 1619-11 bis 1629-12</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=54b168e5dec24ef3a5ca2d42d9661f85" target="_blank">Rotpaur, Georg</a></td></tr>
<tr><td style="width: 35%;">nach 1629-12</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=a76331797bfb45f8a0ea793a50cfd702" target="_blank">Schwarzobm, Christoph</a></td></tr>
<tr><td style="width: 35%;">von 1641-08 bis 1649-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=d55420fe7f1a462395e3571bfa80acb8" target="_blank">Hofman, Sebastian</a></td></tr>
<tr><td style="width: 35%;">etwa 1645</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3861d018bbb24f82ae5c2304e45f671a" target="_blank">Schwarzobm, Joannes</a></td></tr>
