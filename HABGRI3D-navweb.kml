<tr><td style="width: 35%;">zweites Viertel 17.Jhdt.</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=38b03ffc319243b19c40efeb119eb4a1" target="_blank">Häring, Simon</a></td></tr>
