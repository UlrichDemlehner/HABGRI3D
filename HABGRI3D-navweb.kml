<tr><td style="width: 35%;">nach 1599</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=96a24b7807f149d289899c76c149b920" target="_blank">Puschl, Georg</a></td></tr>
