<tr><td style="width: 35%;">nach 1636-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=eed7943e797d40bba5e89397b9d05204" target="_blank">Knoglhamer, Simon</a></td></tr>
