<tr><td style="width: 35%;">nach 1735-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=01aab5ceea994a21a01fca3802c77dca" target="_blank">Christöffl, Georg</a></td></tr>
<tr><td style="width: 35%;">nach 1787-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0aa24a30f217407e887cb52b4cfff255" target="_blank">Klosterhuber, Andreas</a></td></tr>
