<tr><td style="width: 35%;">nach 1706-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6fe1b4c722aa4aaf8e9c37b9dbc6c353" target="_blank">Schönmosser, Georg (Gregorius)</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:28 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.17322000,48.35730000,0</coordinates></Point></Placemark>
