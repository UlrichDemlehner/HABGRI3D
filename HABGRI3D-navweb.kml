<tr><td style="width: 35%;">nach 1738-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=2b41ad8ccda046d297f6d78be01b13e4" target="_blank">Aichelseher, Franciscus</a></td></tr>
<tr><td style="width: 35%;">nach 1788</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=cf3dc3eeea604d6cbb4220106a5cfbdf" target="_blank">Graf, Josephus</a></td></tr>
<tr><td style="width: 35%;">nach 1806-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=58383e3eeae041e1b8fbfe6fafee056c" target="_blank">Graf, Joseph</a></td></tr>
