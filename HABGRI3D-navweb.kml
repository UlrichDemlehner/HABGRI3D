<tr><td style="width: 35%;">1621</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e458ac8ba1c744599f2a26f2d674576f" target="_blank">Veldtpaur, Georg (Vinzenz)</a></td></tr>
<tr><td style="width: 35%;">etwa 1700</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5ba2c5e7d27540709a56d220d689da9b" target="_blank">Veldbaur, Joannes</a></td></tr>
