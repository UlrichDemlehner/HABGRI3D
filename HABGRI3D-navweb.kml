<tr><td style="width: 35%;">von 1808-02 bis 1838-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ed22b4cd5d8d46518bb2151cc35a206e" target="_blank">Demlbauer, Sebastian</a></td></tr>
<tr><td style="width: 35%;">von 1838-11 bis 1866-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5151d781b4614d20ae84b695a3ba8ccd" target="_blank">Demmelbauer, Georg</a></td></tr>
<tr><td style="width: 35%;">nach 1866-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=a64d7c0f1e1645559a15cf874473ac56" target="_blank">Roiner, Jakob</a></td></tr>
<tr><td style="width: 35%;">von 1899-08 bis 1907-03</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=340c0676f0a54d10816cf849a95f1b7b" target="_blank">Roiner, Johann</a></td></tr>
