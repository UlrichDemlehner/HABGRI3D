<tr><td style="width: 35%;">nach 1664-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=32cf4b35ed6547bba8ec00c7d8a7b792" target="_blank">Sieghartsmüller, Joseph</a></td></tr>
