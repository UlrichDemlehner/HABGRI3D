<tr><td style="width: 35%;">von 1666-05 bis 1716-03</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c5ff1f3c214144559a5ff8597205b7d6" target="_blank">Wäger, Georgius</a></td></tr>
