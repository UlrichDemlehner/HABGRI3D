<tr><td style="width: 35%;">1649</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6c24101083bc444aac2053dbb97ef60a" target="_blank">Schwarz, Andreas</a></td></tr>
<tr><td style="width: 35%;">nach 1672-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=01d69ceb2902487c9cddb6e2d254c373" target="_blank">Aichinger, Joseph</a></td></tr>
<tr><td style="width: 35%;">nach 1703-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ca6bf4d1f67043169e0dcd0d9b01e318" target="_blank">Riemayr, Andreas</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:30 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,128,0/triangle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.32425000,48.43796000,0</coordinates></Point></Placemark>
