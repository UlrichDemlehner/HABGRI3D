<Placemark><name>Ehrlküner</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Ehrlküner</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Untertattenbach (Pfr Birnbach - DE-84364)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">1/2 Hrscht Altfraunhofen</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Untertattenbach No 78</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">Nennung im HAB: <i>Ehrlküner z Untertattenbach (Pfr Birnbach - DE-84364) [1/2 Hrscht Altfraunhofen]</i></td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='https://geoportal.bayern.de/bayernatlas/?zoom=15&bgLayer=historisch&lang=de&topic=ba&E=800605&N=5373719&crosshair=marker'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=4d7f265ca67f4c5d87bab98747167c41">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">keine Daten<td style="width: 65%;">keine Daten</td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr