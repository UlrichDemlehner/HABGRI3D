<tr><td style="width: 35%;">nach 1734-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=06f8980132644f8c835808a601c9bb56" target="_blank">Judenfeind, Thomas</a></td></tr>
<tr><td style="width: 35%;">nach 1770-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=79f8ba9eaff24769af7df45b8aa316fd" target="_blank">Judenfeind, Andreas</a></td></tr>
<tr><td style="width: 35%;">nach 1829-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6ec4a879331e40f999554abdb3c50711" target="_blank">Judenfeind, Thomas</a></td></tr>
