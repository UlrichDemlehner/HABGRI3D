<tr><td style="width: 35%;">1619</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3c8a948a30c74c6cac4213102d35a246" target="_blank">Äschperzhueber, Stephan (Hanns)</a></td></tr>
