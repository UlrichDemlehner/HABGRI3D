<tr><td style="width: 35%;">von 1602 bis 1630-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0c5b3ee71cdf4739b0aa4baf8261f8be" target="_blank">Khaiser, Georg</a></td></tr>
