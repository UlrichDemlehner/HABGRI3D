<tr><td style="width: 35%;">nach 1606</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=eab37ea1803947889da1f94aa97e8e5f" target="_blank">Weeger, Sigmundt (Georg)</a></td></tr>
<tr><td style="width: 35%;">1637</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=375441a9a1d6479cb5f4a3beb1b3e037" target="_blank">Kheuer, Sigmund</a></td></tr>
