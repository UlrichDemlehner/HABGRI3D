<tr><td style="width: 35%;">1625</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3612b1ec2a1f4e51b57a0de339de5a71" target="_blank">Vorssteder, Sebastian</a></td></tr>
