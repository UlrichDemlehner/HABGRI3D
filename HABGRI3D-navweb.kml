<Placemark><name>Pelzenschneider</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Pelzenschneider</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Hasling (Pfr Holzkirchen DE-94496)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">unb</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Söldenau No 85</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">Andre Etzinger</td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='https://geoportal.bayern.de/bayernatlas/?zoom=15&bgLayer=historisch&lang=de&topic=ba&catalogNodes=11,122&E=812851&N=5387504&crosshair=marker'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/place.html?pgid=NA">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">keine Daten<td style="width: 65%;">keine Daten</td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:28 2026</td></tr></tbody></table></div>]]></descrip