<tr><td style="width: 35%;">nach 1622-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=256c5cd6fc6445769e76a40825a7c9b5" target="_blank">Mair, Gregorius</a></td></tr>
<tr><td style="width: 35%;">nach 1623-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=bd4dd9c91dbc42d799b0dacebf818c39" target="_blank">Hueber, Sebastian</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:29 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.14537000,48.45238000,0</coordinates></Point></Placemark>
