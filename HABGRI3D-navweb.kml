<tr><td style="width: 35%;">von 1602 bis 1604-09</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=8ac2cfb93eaf4d1da054f6930c0f3913" target="_blank">Wibmaur, Christoff</a></td></tr>
