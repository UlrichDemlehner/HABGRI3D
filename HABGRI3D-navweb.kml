<tr><td style="width: 35%;">von 1602 bis 1621-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=cc13434ccb074d758f61f4ec5dfc04c5" target="_blank">Loder, Georg</a></td></tr>
