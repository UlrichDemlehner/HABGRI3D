<tr><td style="width: 35%;">von 1630-11 bis 1633-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=a3b73629918a4f4599a41e4422adde45" target="_blank">Ganzhueber, Urbanus</a></td></tr>
<tr><td style="width: 35%;">nach 1633-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=adf920af8f37488dbd58f084a805a1c8" target="_blank">Hueber, Anndre</a></td></tr>
