<tr><td style="width: 35%;">von 1636 bis 1667-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=049e755551224e169740d77d437ba6f9" target="_blank">Prannz, Georg</a></td></tr>
