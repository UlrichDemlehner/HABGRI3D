<tr><td style="width: 35%;">etwa 1740</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=b3b99142e77c4e259b10c76ae6a3b8a6" target="_blank">Meistbauer, Joannes</a></td></tr>
