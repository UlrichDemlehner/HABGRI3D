<tr><td style="width: 35%;">von 1844-02 bis 1858-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c7a910534d0f43dab0965fa9e4e28983" target="_blank">Wimmer, Therese</a></td></tr>
