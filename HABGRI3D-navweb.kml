<tr><td style="width: 35%;">nach 1689</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e04ee232a12a4b649ea285fdc133f8a6" target="_blank">Marxbauer, Matthias</a></td></tr>
