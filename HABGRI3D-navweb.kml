<tr><td style="width: 35%;">um 1700 bis bis 1713-06-00</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e6c1285fa2d44ed68cece985a4250867" target="_blank">Dischler, Georgius</a></td></tr>
