<tr><td style="width: 35%;">nach 1706</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=f783f5a5b0a4464e975294f63148855f" target="_blank">Haas, Simon</a></td></tr>
<tr><td style="width: 35%;">nach 1716</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=447a3c38b45441bebeb91cad2313d414" target="_blank">Prand, Martinus</a></td></tr>
