<tr><td style="width: 35%;">nach 1649-01</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=318f42942b6f4a1cb4cfba6313efb489" target="_blank">Hueber, Josephus</a></td></tr>
