<tr><td style="width: 35%;">1689</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0c922752612b485fb6cd3a5cb8e1240f" target="_blank">Lehner, Martinus</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:30 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.31698000,48.42885000,0</coordinates></Point></Placemark>
