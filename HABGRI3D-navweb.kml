<tr><td style="width: 35%;">nach 1758-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3dc634552876470a9a9d58cdfd2423a0" target="_blank">Carlstädter, Andreas</a></td></tr>
