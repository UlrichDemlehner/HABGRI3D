<tr><td style="width: 35%;">nach 1641</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=b3264651231347e3ab6978ba88113e75" target="_blank">Schneider, Joachim</a></td></tr>
