<tr><td style="width: 35%;">nach 1636-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5c1e260f13df4b709c7fb9652e2de23a" target="_blank">Völlmayr, Georg (Gregorius)</a></td></tr>
