<tr><td style="width: 35%;">nach 1636-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=732954e4bbc7477d8ccbc348700909d8" target="_blank">Mittermayr, Mathäus</a></td></tr>
<tr><td style="width: 35%;">letztes Viertel 17.Jhdt.</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3bd052644f4449d0930c65fa00f4c7dd" target="_blank">Pauer, Joseph</a></td></tr>
