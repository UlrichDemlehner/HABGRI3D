<tr><td style="width: 35%;">von 1627-11 bis 1649-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6707a0a02dc2499897b5a6cfaf0de72b" target="_blank">Prumer, Blasy (Jacobus)</a></td></tr>
<tr><td style="width: 35%;">nach 1649-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=8c754ea521ba437588cf731a113ad3b1" target="_blank">Prumer, Abraham</a></td></tr>
