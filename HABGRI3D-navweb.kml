<tr><td style="width: 35%;">nach 1602</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=bf99e95529c643e8b1fb85fda61b408c" target="_blank">Primbs, Andreas</a></td></tr>
<tr><td style="width: 35%;">nach 1664</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e050c877f6694c50bf4bd5311d9ec287" target="_blank">Prims, Georgius</a></td></tr>
<tr><td style="width: 35%;">von 1679-07 bis 1692-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=4def601454cd4235ac84d1e85b030b73" target="_blank">Primbs, Pernhardt</a></td></tr>
