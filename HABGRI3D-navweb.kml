<tr><td style="width: 35%;">1650</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=da5955ae11f4442bb2ca2e30a6fc664c" target="_blank">Mundl, Martin</a></td></tr>
