<tr><td style="width: 35%;">von 1656-06 bis 1704-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=d4074f853ce04a2595c9566c8ea85ea7" target="_blank">Puechögger, Thomas</a></td></tr>
<tr><td style="width: 35%;">von 1704-09 bis 1743-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=98d128eb6bca4bc59655819992546c0b" target="_blank">Puechögger, Adam</a></td></tr>
