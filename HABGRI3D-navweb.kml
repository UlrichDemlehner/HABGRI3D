<tr><td style="width: 35%;">1.Viertel 19.Jhdt.</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6dbc36095c2a4386a2e30b322df86883" target="_blank">Edtnwöger, Jacobus</a></td></tr>
<tr><td style="width: 35%;">nach 1830-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0cd179a05959403f8b1daecfcb4a901e" target="_blank">Edenweger, Benedikt</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:28 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.30021000,48.51394000,0</coordinates></Point></Placemark>
