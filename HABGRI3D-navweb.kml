<tr><td style="width: 35%;">nach 1740-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=f75dbc526cb54b869e0594b5de70cabf" target="_blank">Auer, Jacobus</a></td></tr>
