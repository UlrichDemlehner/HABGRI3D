<tr><td style="width: 35%;">etwa 1685</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9fe6c7b545f04a57a388dea2b5d16c00" target="_blank">Fickl, Caspar</a></td></tr>
