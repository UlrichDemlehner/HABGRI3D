<tr><td style="width: 35%;">nach 1714</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=34446f5b459244db91f22e62969e868c" target="_blank">Häberl, Georgius</a></td></tr>
<tr><td style="width: 35%;">von 1723-06 bis 1734-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=565312f2fce24e4bbe8b1d5a1a7623c8" target="_blank">Nidermayr, Vitus</a></td></tr>
<tr><td style="width: 35%;">von 1734-11 bis 1779-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=cbc815ef96c1479bbf91febc2233f18b" target="_blank">Kirschner, Jacobus</a></td></tr>
