<tr><td style="width: 35%;">nach 1602</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6416d308fc4e4187aa848becf770c0f9" target="_blank">Gimppel, Christof (Georg)</a></td></tr>
