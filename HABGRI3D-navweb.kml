<tr><td style="width: 35%;">1611</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3b90b2734e884873aea16dad14fa481b" target="_blank">Fröschl, Christoph</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:31 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.19274000,48.52508000,0</coordinates></Point></Placemark>
<Placemark><name>Ester</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Ester</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Hollerbach (Pfr Aidenbach DE-94501)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">1/2 Hrscht Haidenburg</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Aldersbach No 31</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">im HAB Ester, im Kataster Aster oder Äster</td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='http://geoportal.bayern.de/bayernatlas/?zoom=15&bgLayer=historisch&lang=de&topic=ba&E=801909&N=5386516&crosshair=marker'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/place.html?pgid=NA">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">keine Daten<td style="width: 65%;">keine Daten</td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:31 2026</td></tr></tbody></table></div>]]><