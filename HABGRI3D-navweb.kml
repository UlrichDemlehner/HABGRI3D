<tr><td style="width: 35%;">nach 1613</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=752b0f03ad5c427581c7956e27fae2bf" target="_blank">Göschl, Stephan</a></td></tr>
