<tr><td style="width: 35%;">nach 1682</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=1c77062451c94d7591322de2d7eb5eda" target="_blank">Mospauer, Laurentius (Georg)</a></td></tr>
<tr><td style="width: 35%;">nach 1763-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=7f2ce37409a1422281a4d3356591fa86" target="_blank">Pilzweger, Thomas</a></td></tr>
