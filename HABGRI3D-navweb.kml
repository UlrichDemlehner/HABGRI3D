<Placemark><name>Waldäderer</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Waldäderer</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Waldaderer i Mahd (Pfr Holzkirchen - DE-94081)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">Grfscht Neuburg a Inn</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Sandbach No 84</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">Nennung im HAB: <i>Waldäderer z Waldaderer i Mahd (Pfr Holzkirchen - DE-94081) [Grfscht Neuburg a Inn]</i></td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='https://geoportal.bayern.de/bayernatlas/?zoom=15&bgLayer=historisch&lang=de&topic=ba&E=816225&N=5389819&crosshair=marker'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=325218d60f8c4743ad16cad57f68201d">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">etwa 1610</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=04c69706677a4df78e36d095962ff519" target="_blank">Waltöderer, Hanns</a></td></tr>
