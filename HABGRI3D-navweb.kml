<tr><td style="width: 35%;">1685</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=a82e1ca2aab24f64850917d630f3924b" target="_blank">Weidinger, Michael</a></td></tr>
<tr><td style="width: 35%;">1706</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=fa06f26d7b1a49099a989521c24abde6" target="_blank">Weidinger, Blasi (Michael)</a></td></tr>
<tr><td style="width: 35%;">nach 1753-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=35ad944d61c04a0ea87b097743ad1e2e" target="_blank">Weydinger, Joannes</a></td></tr>
