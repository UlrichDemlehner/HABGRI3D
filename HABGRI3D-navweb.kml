<tr><td style="width: 35%;">von 1696-03 bis 1700-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=2ee0139a20ab496d858a9dc6a9665b70" target="_blank">Wagersperger, Philippus</a></td></tr>
