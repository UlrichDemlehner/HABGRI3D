<tr><td style="width: 35%;">nach 1824</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=960151d6427e4f32a028f540c3934822" target="_blank">Goderer, Simon</a></td></tr>
