<tr><td style="width: 35%;">von 1804-10 bis 1806-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c375b88343fc4192b45de7abfe8c26e0" target="_blank">Huber, Katharina</a></td></tr>
