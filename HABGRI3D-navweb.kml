<tr><td style="width: 35%;">1671</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6f9236c3fedb458987f7b6f394a2a912" target="_blank">Themel, Wolfgangus</a></td></tr>
