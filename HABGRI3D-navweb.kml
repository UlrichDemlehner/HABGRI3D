<tr><td style="width: 35%;">nach 1620-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c37e7d94897941b991d21037c2cdf3f1" target="_blank">Bauer, Rupertus (Ruprecht)</a></td></tr>
<tr><td style="width: 35%;">nach 1651</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=fc851e04a5a44911a266430e0e336efa" target="_blank">Pauer, Bernardus</a></td></tr>
