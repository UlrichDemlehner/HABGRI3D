<tr><td style="width: 35%;">von 1700-02 bis 1739-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9547a777e1ba49f5ae101bf99d60f839" target="_blank">Kirmayr, Josephus</a></td></tr>
