<tr><td style="width: 35%;">1746</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e4c6ac47d3f44bf6971bb77325e2d464" target="_blank">Mittermayr, Jacobus</a></td></tr>
