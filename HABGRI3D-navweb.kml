<tr><td style="width: 35%;">nach 1729-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=005ce89bafba4d109b78a3aa262808c0" target="_blank">Peninger, Simon</a></td></tr>
