<tr><td style="width: 35%;">nach 1856-03</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ca15485edea94582ad2d735e9b8a53da" target="_blank">Zöls, Benedikt</a></td></tr>
<tr><td style="width: 35%;">nach 1885-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5d022c665e054286a8c7c7ad37c6befa" target="_blank">Zöls, Michael</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:29 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.34595000,48.40951000,0</coordinates></Point></Placemark>
