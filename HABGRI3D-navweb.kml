<Placemark><name>Ernst</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Ernst</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Irching (Pfr Aigen a Inn - DE-94072)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">3/8 HochSt Passau</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Egglfing a Inn No 48</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">Nennung im HAB: <i>Ernst z Irching (Pfr Aigen a Inn - DE-94072) [3/8 HochSt Passau]</i></td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='https://geoportal.bayern.de/bayernatlas/?zoom=15&bgLayer=historisch&lang=de&topic=ba&E=816608&N=5360546&catalogNodes=122&crosshair=marker'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=e59bb215fb71481b940b47106641b57e">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">1772</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=87b749d6a89942d3b579a22719008638" target="_blank">Osterholzer, Marcus</a></td></tr></tbody></table></div><div>