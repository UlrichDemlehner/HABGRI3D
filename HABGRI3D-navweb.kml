<tr><td style="width: 35%;">nach 1750-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ee6c26e28dad491db7c68546e22367a9" target="_blank">Schwab, Joannes (Bernardus)</a></td></tr>
<tr><td style="width: 35%;">nach 1769-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=8f1b59bd91d8464385d6d307f7497790" target="_blank">Obermaier, Johann Baptist</a></td></tr>
