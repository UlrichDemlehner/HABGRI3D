<tr><td style="width: 35%;">nach 1671</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=a01638b6b3e54e9981a82a1c8669d8fe" target="_blank">Mayr, Elias</a></td></tr>
