<tr><td style="width: 35%;">von 1602 bis 1619-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ab510fff825d4284a7fff9fc4389d984" target="_blank">Machaimer, Sebastian</a></td></tr>
