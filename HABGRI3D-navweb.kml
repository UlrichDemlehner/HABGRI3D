<tr><td style="width: 35%;">nach 1648-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=4aad82f6f4c941059f0eccc6b858b827" target="_blank">Kirsner, Caspar</a></td></tr>
<tr><td style="width: 35%;">von 1687-01 bis 1724-07</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5b8a8e062a7d4f8baf73eb2d6658596e" target="_blank">Khürschner, Georgius</a></td></tr>
<tr><td style="width: 35%;">nach 1724-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=558fc179397f4593b5571c05ce93b648" target="_blank">Kirschner, Petrus</a></td></tr>
<tr><td style="width: 35%;">nach 1773-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=07d9726cbd704335bb5a8a0e9f672377" target="_blank">Kirschner, Joseph</a></td></tr>
<tr><td style="width: 35%;">nach 1813-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c92eab2b998a4a93b3b8771f1297a382" target="_blank">Kirschner, Joseph</a></td></tr>
<tr><td style="width: 35%;">nach 1843-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=8d4e757dae4e4a54b87c97aa7f8b119d" target="_blank">Niedermaier, Josef</a></td></tr>
<tr><td style="width: 35%;">nach 1853-12</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9f411e887b1541e09321a7bb1356de5d" target="_blank">Hofbauer, Jakob</a></td></tr>
