<tr><td style="width: 35%;">von 1811-11 bis 1859-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=b6c133034b324041a5c0898142c72fea" target="_blank">Andorfer, Georg</a></td></tr>
<tr><td style="width: 35%;">nach 1860-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6a8462c16ce24056b2f5674a1972653e" target="_blank">Andorfer, Johann Baptist</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:30 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.25951000,48.46339000,0</coordinates></Point></Placemark>
