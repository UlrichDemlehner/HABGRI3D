<tr><td style="width: 35%;">von 1706-10 bis 1741-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=bf1788239c194e32895ee082d892e101" target="_blank">Suttner, Andreas</a></td></tr>
