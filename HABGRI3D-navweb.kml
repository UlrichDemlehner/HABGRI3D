<tr><td style="width: 35%;">nach 1780-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9ef19589a957463697478d11ef723e08" target="_blank">Frankenberger, Benedikt</a></td></tr>
