<tr><td style="width: 35%;">nach 1750-09</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=60d3ff7d4643437e83fa376e6fbed1fd" target="_blank">Kapsreutter, Thomas</a></td></tr>
<tr><td style="width: 35%;">von 1786-10 bis 1802-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=1247691742d14ab0a1fe831e5b98fafe" target="_blank">Mayrhofer, Thomas</a></td></tr>
<tr><td style="width: 35%;">nach 1802-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=3c28a833b74140b8853f8bb1820b94b0" target="_blank">Paur, Thomas</a></td></tr>
<tr><td style="width: 35%;">nach 1840-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=c01735c372b44477a52b11c295d5d35b" target="_blank">Kapsreither, Thomas</a></td></tr>
