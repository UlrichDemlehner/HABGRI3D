<Placemark><name>Haur</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">Haur</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Thalling (Pfr Weihmörting - DE-94060)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">1/8 HM Schönburg</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">[Gmkg Kühnham No 85] 
