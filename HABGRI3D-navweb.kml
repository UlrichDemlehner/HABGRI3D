<tr><td style="width: 35%;">nach 1802-12</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=4d7ee65885bd4b2cb70a1e00016d49bf" target="_blank">Baumgartner, Johann</a></td></tr>
<tr><td style="width: 35%;">von 1839-09 bis 1852-12</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=885952c1a8e949078d2f36085e683aeb" target="_blank">Baumgartner, Johann Baptist</a></td></tr>
