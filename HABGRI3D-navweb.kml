<tr><td style="width: 35%;">nach 1648-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=89015593081145a7b98c81a0669958fd" target="_blank">Stadlreider, Bartholomäus</a></td></tr>
