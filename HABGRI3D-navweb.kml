<tr><td style="width: 35%;">nach 1602</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=19fb11bf7c414e0dbfe61fefa1e7ac10" target="_blank">Promhofer, Thomas</a></td></tr>
