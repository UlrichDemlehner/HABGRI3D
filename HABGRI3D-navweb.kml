<tr><td style="width: 35%;">1628</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=dd0b0aaa81f84261a1dc5a7ffbcaeb40" target="_blank">Nachtber, Marthin</a></td></tr>
