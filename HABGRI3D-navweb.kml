<tr><td style="width: 35%;">nach 1680</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=25a54f7b7f434af98f2b383e747264ad" target="_blank">Prundobler, Joannes</a></td></tr>
<tr><td style="width: 35%;">nach 1706-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=26a6b9b8c56c4cc38f2e6e356a3e11d7" target="_blank">Ellenbeckh, Josephus</a></td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:31 2026</td></tr></tbody></table></div>]]></description><Style><IconStyle><scale>0.5</scale><Icon><href>https://geoportal.bayern.de/ba-backend/icons/255,0,0/circle</href><gx:w>48</gx:w><gx:h>48</gx:h></Icon></IconStyle><LabelStyle><color>ff000000</color></LabelStyle></Style><Point><coordinates>013.13630000,48.36376000,0</coordinates></Point></Placemark>
