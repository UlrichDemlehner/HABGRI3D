<tr><td style="width: 35%;">nach 1784-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=b530d8b524844ff1a807b50e5ba3da3d" target="_blank">Hisserer, Joannes</a></td></tr>
