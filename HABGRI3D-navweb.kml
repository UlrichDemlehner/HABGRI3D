<tr><td style="width: 35%;">von 1692-07 bis 1734-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=2231162270234797855f40119c6dce53" target="_blank">Lehner, Martinus</a></td></tr>
<tr><td style="width: 35%;">nach 1734-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=99358e54997d4973b62b39dbb7fece9e" target="_blank">Lehner, Martinus</a></td></tr>
