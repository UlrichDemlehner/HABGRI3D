<tr><td style="width: 35%;">nach 1768-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=500a9400f6574607a1f29165a1fd6e82" target="_blank">Niedermayr, Joannes</a></td></tr>
