<tr><td style="width: 35%;">nach 1650-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=7ef49f7e047b4b7d880cb21398f70a9f" target="_blank">Nidermair, Leonhardus (Georgius)</a></td></tr>
