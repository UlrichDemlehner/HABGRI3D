<tr><td style="width: 35%;">nach 1623</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=ebbbf3bdeec341419ad08825b941885b" target="_blank">Nidernhueber, Hannß</a></td></tr>
<tr><td style="width: 35%;">von 1676 bis 1694-09</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=0bd950276b834a50a5262f36c82a8155" target="_blank">Pauer, Georgius</a></td></tr>
<tr><td style="width: 35%;">von 1694-11 bis 1707-10</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=6c5718cf5ffb4ac58cb439c1d817fe08" target="_blank">Mayr, Matthias (Georgius)</a></td></tr>
