<Placemark><name>Singer</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">unb Singer</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Rehschaln (Pfr Irsham - DE-94081)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">Grfscht Neuburg a Inn</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">Gmkg Altenmarkt No 44</td></tr><tr><td style="width: 35%;"><b>Bemerkungen</b></td><td style="width: 65%;">Nennung im HAB: keine -- hier <i>unb Singer z Rehschaln (Pfr Irsham - DE-94081) [Grfscht Neuburg a Inn]</i></td></tr><tr><td style="width: 35%;"><b>Hof in Uraufnahme</b></td><td style="width: 65%;"><a target= '_blank' href='https://v.bayern.de/F97GB'>Klicken um Hof in Uraufnahme anzuzeigen</a></td></tr><tr><td style="width: 35%;"><b>Weitere Informationen</b></td><td style="width: 65%;"><a target= "_blank" href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=1b9eb4eb4848464495d7535fc6f7f75c">Weitere Informationen zum Hof anzeigen</a></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" border="0"><tbody><tr><td><br></td></tr><tr><td><b>Belegte Hofbesitzer</b></td></tr><tr><td><br></td></tr></tbody></table></div><div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="background-color: #cccccc;width: 35%;"><b>Besitzer belegt in</b></td><td style="background-color: #cccccc;width: 65%;"><b>Name des Hofbesitzers</b></td></tr><tr><td style="width: 35%;">keine Daten<td style="width: 65%;">keine Daten</td></tr></tbody></table></div><div><table style="width: 100%;" border="0"><tbody><tr><td style="height: 1cm; background-color: white;"></td></tr><tr><td style="height: 1cm; vertical-align: middle;">Stand der Daten: Tue Jun  2 22:13:28 2026</td></tr></tbody>