<tr><td style="width: 35%;">1629</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=535b65923a4343b3ac9c71ef2d48149e" target="_blank">Reitter, Georg</a></td></tr>
