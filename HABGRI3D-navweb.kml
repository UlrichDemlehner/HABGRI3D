<tr><td style="width: 35%;">von 1625-07 bis 1628-04</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9dffa1da724e4c9faf1d79f78f7c0b99" target="_blank">Resch, Blasy</a></td></tr>
