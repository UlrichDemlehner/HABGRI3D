<tr><td style="width: 35%;">nach 1750</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=2adfb43dccf74f47a494dd95c32c846b" target="_blank">Putzdobler, Simon</a></td></tr>
