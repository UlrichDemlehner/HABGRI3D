<Placemark><name>Prennzinger</name><description><![CDATA[<div><table style="width: 100%; float: left;" cellpadding="5" border="1"><tbody><tr><td style="width: 35%;"><b>Hofname(n)</b></td><td style="width: 65%;">unb Prennzinger</td></tr><tr><td style="width: 35%;"><b>Ort (Pfarrei)</b></td><td style="width: 65%;">Würding (Pfr - DE-94072)</td></tr><tr><td style="width: 35%;"><b>Hoffuß/Stift/Grundherr</b></td><td style="width: 65%;">1/4 eigen</td></tr><tr><td style="width: 35%;"><b>Haus Nr in Urkataster</b></td><td style="width: 65%;">[Gmkg Würding No xxx] 
