<tr><td style="width: 35%;">nach 1809-08</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=687fd3aabd2f46c597d6cb6ecc4adf71" target="_blank">Dingelreiter, Florian</a></td></tr>
