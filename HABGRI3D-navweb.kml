<tr><td style="width: 35%;">nach 1706-05</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=eba1cb6d9e274aeb91042bf29a856c63" target="_blank">Meissauer, Stephanus</a></td></tr>
