<tr><td style="width: 35%;">1602</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=310b31915335422f9b6a3927d818e873" target="_blank">Liebhard, Christoff</a></td></tr>
<tr><td style="width: 35%;">nach 1609</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=f0b9f9112f37445c87e68172dffc1d0f" target="_blank">Sager, Sebastian</a></td></tr>
