<tr><td style="width: 35%;">nach 1667</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=9429fb1ecc41443c96a078ccc5520cf3" target="_blank">Prunner, Georg</a></td></tr>
<tr><td style="width: 35%;">nach 1722-06</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=5f90a364afdd4945928215203ceffe59" target="_blank">Prunmayr, Georgius</a></td></tr>
