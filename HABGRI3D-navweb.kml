<tr><td style="width: 35%;">nach 1753-11</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=738729d1c5394323a1c1146ffd2fea6d" target="_blank">Stainperger, Jacobus</a></td></tr>
