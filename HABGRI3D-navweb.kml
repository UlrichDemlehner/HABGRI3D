<tr><td style="width: 35%;">von 1748-07 bis 1781-02</td><td style="width: 65%;"><a href="https://landgericht-griesbach.info/NAVWEB/display_page.php?page=cb28f12c8be946a4913bc799114fce1d" target="_blank">Gstöttl, Mathias</a></td></tr>
